{
  "name": "fan-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "up": "bash scripts/up.sh",
    "db:dev": "node scripts/dev-db.ts",
    "demo": "node --conditions=react-server scripts/demo.ts",
    "backtest": "node --env-file=.env --conditions=react-server scripts/backtest.ts",
    "test": "npm run check && npm run test:unit && npm run test:e2e",
    "test:unit": "node --conditions=react-server --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "node --conditions=react-server tests/e2e/run.ts",
    "check": "tsc --noEmit && node scripts/check-boundaries.ts && knip"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "latest",
    "next": "^16.4.6",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "knip": "^6.45.1",
    "typescript": "^5.9.0"
  }
}
