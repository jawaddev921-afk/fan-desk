# REQUIRED. 32 random bytes as hex. Encrypts every user's Fans API key at rest.
# Generate: openssl rand -hex 32     (if you lose it, saved keys cannot be decrypted)
APP_SECRET=

# REQUIRED. Postgres connection string. Local: run `npm run db:dev` in another terminal (it prints this line).
# Production (Supabase): the POOLER url in transaction mode, ending in ?sslmode=require. Use only the database, not Supabase auth.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# Connections the server keeps open (serverless: keep it small)
# DB_POOL_MAX=5

# Email (resend.com) for the sign-up confirmation link. With a key set, an account is created only after its email is confirmed.
# EMAIL_FROM must be an address on a domain verified in Resend (the default onboarding@resend.dev only reaches the Resend account owner).
# Unset: no email is sent and sign-up needs no confirmation (local development).
RESEND_API_KEY=
EMAIL_FROM=Fan Desk <onboarding@resend.dev>

# Shared secret for /api/cron/tick (Vercel Cron sends it as `Authorization: Bearer ...`; set the same value in Vercel's env).
# Unset: that endpoint is off. Generate: openssl rand -hex 32
CRON_SECRET=

# Public HTTPS address of this server (no trailing slash). Needed to register webhooks.
# Local testing: cloudflared tunnel --url http://localhost:3000  -> paste the https URL here
PUBLIC_URL=

PORT=3000
ALLOW_SIGNUP=true
# Set true only when running behind your own reverse proxy (uses X-Forwarded-For for rate limits)
TRUST_PROXY=false

FANSAPI_BASE_URL=https://api.fansapi.com/api

# AI: claude (needs ANTHROPIC_API_KEY) or ollama (free, local testing)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Wait this long after a fan's last message/typing before the AI replies
REPLY_DEBOUNCE_MS=8000
